rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona solo puede leer y escribir sus propios datos, y solo bloques de tamaño razonable.
    match /users/{uid}/sync/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt'])
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Colecciones de equipo (gratis por ahora). El id del documento es un hash del código de invitación y el contenido va
    // cifrado con una clave derivada de ese código: el servidor no puede leerlo. Quien tenga el código puede leer y
    // escribir; solo quien la creó (owner) puede borrarla o listar las suyas (se usa al eliminar la cuenta).
    match /teams/{id} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt', 'owner'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
