rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function paid(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/billing/status)
        && get(/databases/$(database)/documents/users/$(uid)/billing/status).data.active == true;
    }

    // Estado de la suscripción: lo escribe solo el Worker de Cloudflare (cuenta de servicio, que se salta estas reglas).
    match /users/{uid}/billing/{doc} {
      allow read, delete: if owner(uid); // borrar solo se usa al eliminar la cuenta
      allow create, update: if false;
    }

    // Datos cifrados: leer y borrar siempre se puede (nadie se queda sin sus datos); subir exige suscripción activa.
    match /users/{uid}/sync/{doc} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && paid(uid)
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt'])
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
    }

    // Colecciones de equipo (gratis por ahora). El id del documento es un hash del código de invitación y el contenido va
    // cifrado con una clave derivada de ese código: el servidor no puede leerlo. Quien tenga el código puede leer y
    // escribir; solo quien la creó (owner) puede borrarla o listar las suyas (se usa al eliminar la cuenta).
    match /teams/{id} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt', 'owner'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['blob', 'updatedAt', 'owner'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.blob is string
        && request.resource.data.blob.size() < 900000
        && request.resource.data.updatedAt is int;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
