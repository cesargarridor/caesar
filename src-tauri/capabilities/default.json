{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability: the webview can invoke ONLY Caesar's own IPC commands (each listed explicitly as allow-<command>; see build.rs AppManifest) and LISTEN to events (request progress). No fs, shell, http or window APIs are granted. The file dialog is opened from Rust, never from JS. DO NOT add a 'remote' capability (remote.urls): the OAuth window loads an external page and must never get IPC access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-import-collection-file",
    "allow-pick-text-file",
    "allow-pick-text-files",
    "allow-parse-collection-content",
    "allow-execute-request",
    "allow-open-url",
    "allow-pick-file",
    "allow-save-text-file",
    "allow-save-response-file",
    "allow-app-version",
    "allow-check-update",
    "allow-install-update",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-restore",
    "allow-vault-forget",
    "allow-vault-recovery",
    "allow-vault-rotate",
    "allow-vault-replace",
    "allow-vault-encrypt",
    "allow-vault-decrypt",
    "allow-pairing-begin",
    "allow-pairing-code",
    "allow-pairing-finish",
    "allow-pairing-approve-start",
    "allow-pairing-approve-confirm",
    "allow-pairing-cancel",
    "allow-sync-status",
    "allow-local-save",
    "allow-local-load",
    "allow-local-wipe",
    "allow-sync-sign-in",
    "allow-sync-reset-password",
    "allow-flush-done",
    "allow-sync-google",
    "allow-sync-link-confirm",
    "allow-sync-link-cancel",
    "allow-sync-github-begin",
    "allow-sync-github-finish",
    "allow-sync-sign-out",
    "allow-sync-now",
    "allow-oauth-authorize",
    "allow-deeplink-take",
    "allow-mock-start",
    "allow-mock-stop",
    "allow-mock-status",
    "allow-ai-status",
    "allow-ai-set-key",
    "allow-ai-clear-key",
    "allow-ai-chat",
    "allow-history-add",
    "allow-history-list",
    "allow-history-clear",
    "allow-import-openapi",
    "allow-runner-pick-csv",
    "allow-sync-cancel",
    "allow-sync-billing",
    "allow-sync-delete-account",
    "allow-sync-checkout-url",
    "allow-team-publish",
    "allow-team-join",
    "allow-team-push",
    "allow-team-pull",
    "allow-check-trial-and-whitelist",
    "allow-redeem-code",
    "allow-record-terms",
    "allow-account-state",
    "allow-sync-link-idp",
    "allow-sync-role",
    "allow-sync-activate",
    "allow-sync-show-key",
    "allow-sync-regenerate-key",
    "allow-sync-enter-key",
    "allow-sync-make-master",
    "allow-team-unshare",
    "allow-ws-connect",
    "allow-ws-send",
    "allow-ws-close"
  ]
}
